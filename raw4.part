let state='menu',levelIndex=0,score=0,angle=45*Math.PI/180,charging=false,charge=0,selectedAmmo='pebbles',wind=0,shotsUsed=0,ammo={pebbles:0,stone:0,boulder:0},projectiles=[],blocks=[],enemies=[],barrels=[],particles=[],clouds=[],cameraShake=0,shotActive=false,levelEndTimer=0,lastTime=performance.now(),toastTimer=0,unlocked=Number(localStorage.getItem('siegewindUnlocked')||1),stars=JSON.parse(localStorage.getItem('siegewindStars')||'[]');

let audioCtx=null;
function sound(type,power=1){try{if(!audioCtx)audioCtx=new (window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();const t=audioCtx.currentTime,o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);if(type==='launch'){o.type='sawtooth';o.frequency.setValueAtTime(160,t);o.frequency.exponentialRampToValueAtTime(55,t+.28);g.gain.setValueAtTime(.12*power,t);g.gain.exponentialRampToValueAtTime(.001,t+.32);o.start(t);o.stop(t+.33)}else if(type==='hit'){o.type='triangle';o.frequency.setValueAtTime(90+80*power,t);o.frequency.exponentialRampToValueAtTime(35,t+.17);g.gain.setValueAtTime(.12*power,t);g.gain.exponentialRampToValueAtTime(.001,t+.2);o.start(t);o.stop(t+.21)}else if(type==='boom'){o.type='square';o.frequency.setValueAtTime(70,t);o.frequency.exponentialRampToValueAtTime(24,t+.5);g.gain.setValueAtTime(.18,t);g.gain.exponentialRampToValueAtTime(.001,t+.55);o.start(t);o.stop(t+.56)}else if(type==='win'){o.type='triangle';g.gain.setValueAtTime(.08,t);[0,1,2].forEach((i)=>o.frequency.setValueAtTime([440,554,659][i],t+i*.12));g.gain.exponentialRampToValueAtTime(.001,t+.48);o.start(t);o.stop(t+.5)}}catch(e){}}

function showToast(text,ms=1200){UI.toast.textContent=text;UI.toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>UI.toast.classList.remove('show'),ms)