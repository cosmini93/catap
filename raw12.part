);ctx.fillStyle=e.elite?'#7e2841':'#4d6879';roundRect(ctx,-e.r*.62,-e.r*.25,e.r*1.24,e.r*1.25,5);ctx.fill();circle(0,-e.r*.45,e.r*.7,'#d9b178','#271b18',3);ctx.fillStyle=e.elite?'#d8af46':'#4c5967';poly([[-e.r*.72,-e.r*.45],[0,-e.r*1.22],[e.r*.72,-e.r*.45],[e.r*.52,-e.r*.16],[-e.r*.52,-e.r*.16]],ctx.fillStyle,'#22191a',3);ctx.fillStyle='#251916';circle(-e.r*.22,-e.r*.47,2.2,'#251916');circle(e.r*.22,-e.r*.47,2.2,'#251916');ctx.strokeStyle='#25202a';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(-e.r*.6,e.r*.95);ctx.lineTo(-e.r*.7,e.r*1.35);ctx.moveTo(e.r*.6,e.r*.95);ctx.lineTo(e.r*.7,e.r*1.35);ctx.stroke();ctx.restore()}
function drawBarrel(b){if(b.dead)return;ctx.save();ctx.translate(b.x,b.y);ctx.fillStyle='#7e3925';roundRect(ctx,-14,-18,28,36,7);ctx.fill();ctx.strokeStyle='#2a1c1b';ctx.lineWidth=4;ctx.stroke();ctx.strokeStyle='#d8a43e';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(-14,-8);ctx.lineTo(14,-8);ctx.moveTo(-14,8);ctx.lineTo(14,8);ctx.stroke();ctx.fillStyle='#ffe172';ctx.font='bold 16px sans-serif';ctx.textAlign='center';ctx.fillText('!',0,6);ctx.restore()}
function drawProjectile(p){for(let i=0;i<p.trail.length;i++){const q=p.trail[i],a=(i+1)/p.trail.length*.25;ctx.globalAlpha=a;circle(q.x,q.y,p.r*(.25+i/p.trail.length*.55),p.type==='pebbles'?'#f0e1bf':'#d4b98d')}ctx.globalAlpha=1;if(!p.alive)return;const g=ctx.createRadialGradient(p.x-p.r*.35,p.y-p.r*.4,2,p.x,p.y,p.r);g.addColorStop(0,'#e2d7bd');g.addColorStop(1,p.type==='boulder'?'#3b373a':'#6d665e');circle(p.x,p.y,p.r,g,'#211e21',3)}
function drawParticles(){for(const p of particles){ctx.save();ctx.globalAlpha=clamp(p.life/p.max,0,1);ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.color;ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size);ctx.restore()}ctx.globalAlpha=1}
function render(t){screenTransform();ctx.fillStyle='#07101e';ctx.fillRect(0,0,W,H);worldTransform();ctx.save();if(cameraShake>0)ctx.translate(rand(-cameraShake,cameraShake),rand(-cameraShake,cameraShake));drawBackground(t);drawCatapult(t);for(const b of blocks)if(!b.dead)drawBlock(b);for(const br of barrels)drawBarrel(br);for(const e of enemies)drawEnemy(e,t);for(const p of projectiles)drawProjectile(p);drawParticles();ctx.restore();
 // letterbox gloss
 screenTransform();const vg=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*.2,W/2,H/2,Math.max(W,H)*.72);vg.addColorStop(.55,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.38)');ctx.fillStyle=vg;ctx.fillRect(0,0,W,H)}
function frame(now){const dt=Math.min(.033,(now-lastTime)/1000);lastTime=now;if(state==='play'||state==='ending')updatePhysics(dt);render(now/1000);requestAnimationFrame(frame)}requestAnimationFrame(frame);

$('playBtn').onclick=()=>startLevel(Math.min(unlocked-1,LEVELS.length-1));$('levelsBtn').onclick=showLevels;$('restartBtn').onclick=resetLevel;$('menuBtn').onclick=()=>{charging=false;showMenu()};$('fullscreenBtn').onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscre