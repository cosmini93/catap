 // sail
 poly([[-105,-28],[-104,-175],[-27,-138],[-27,-42]],'#b63827','#37130f',5);ctx.strokeStyle='#2a1714';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(-105,-175);ctx.lineTo(-27,-138);ctx.moveTo(-105,-105);ctx.lineTo(-27,-80);ctx.stroke();
 // arm changes with charge
 const armA=lerp(-.2,-.95,charge);ctx.save();ctx.translate(-25,-105);ctx.rotate(armA);ctx.fillStyle='#7b4d2f';roundRect(ctx,-16,-14,205,28,8);ctx.fill();ctx.strokeStyle='#2a1713';ctx.lineWidth=5;ctx.stroke();ctx.fillStyle='#24212a';ctx.beginPath();ctx.ellipse(188,0,29,21,0,0,TAU);ctx.fill();ctx.stroke();ctx.restore();
 // tension ropes
 ctx.strokeStyle='#221a17';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-22,-105);ctx.lineTo(88,25);ctx.moveTo(-22,-105);ctx.lineTo(-110,20);ctx.stroke();
