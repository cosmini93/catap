function blockColor(b){if(b.type==='wood')return ['#8d5631','#5f3423'];if(b.type==='ice')return ['#b7e6ed','#6ea2b0'];if(b.type==='dark')return ['#5d5558','#332f35'];return ['#b8a98e','#7d7061']}
function drawBlock(b){ctx.save();ctx.translate(b.x,b.y);ctx.rotate(b.angle);const c=blockColor(b),g=ctx.createLinearGradient(-b.w/2,-b.h/2,b.w/2,b.h/2);g.addColorStop(0,c[0]);g.addColorStop(1,c[1]);ctx.fillStyle=g;roundRect(ctx,-b.w/2,-b.h/2,b.w,b.h,Math.min(7,b.w*.08,b.h*.08));ctx.fill();ctx.strokeStyle='rgba(30,24,23,.8)';ctx.lineWidth=4;ctx.stroke();
 if(b.type==='wood'){ctx.strokeStyle='rgba(50,24,13,.46)';ctx.lineWidth=2;for(let y=-b.h/2+15;y<b.h/2;y+=20){ctx.beginPath();ctx.moveTo(-b.w/2+5,y);ctx.bezierCurveTo(-b.w/5,y-6,b.w/5,y+6,b.w/2-5,y);ctx.stroke()}}
 else{ctx.strokeStyle='rgba(255,255,255,.17)';ctx.lineWidth=2;for(let y=-b.h/2+24;y<b.h/2;y+=34){ctx.beginPath();ctx.moveTo(-b.w/2+5,y);ctx.lineTo(b.w/2-5,y+rand(-5,5));ctx.stroke()}if(b.hp<b.maxHp*.7){ctx.strokeStyle='rgba(34,30,34,.65)';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(0,-b.h*.2);ctx.lineTo(-b.w*.18,0);ctx.lineTo(b.w*.08,b.h*.15);ctx.lineTo(-b.w*.05,b.h*.36);ctx.stroke()}}
 // top light
 ctx.strokeStyle='rgba(255,255,255,.23)';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-b.w/2+6,-b.h/2+5);ctx.lineTo(b.w/2-6,-b.h/2+5);ctx.stroke();
 if(b.flash>0){ctx.globalAlpha=b.flash;ctx.fillStyle='#fff';roundRect(ctx,-b.w/2,-b.h/2,b.w,b.h,5);ctx.fill()}
 ctx.restore()}
function drawEnemy(e,t){if(e.dead){if(e.hit>0){ctx.globalAlpha=clamp(e.hit,0,1);circle(e.x,e.y,e.r*1.8,'rgba(255,215,92,.18)');ctx.globalAlpha=1}return}ctx.save();ctx.translate(e.x,e.y);const bob=Math.sin(t*3+e.blink)*1.8;ctx.translate(0,bob);ctx.fillStyle='rgba(0,0,0,.3)';ctx.beginPath();ctx.ellipse(0,e.r+5,e.r*.8,5,0,0,TAU);ctx.fill(