{
 "cod": "FLX-31",
 "nume": "FLX-31 Evaluarea loturilor de stabilizare",
 "val": 3,
 "conexiuni_necesare": [
  "shared_commondataserviceforapps",
  "shared_office365"
 ],
 "definitie": {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
   "$connections": {
    "defaultValue": {},
    "type": "Object"
   },
   "rd_EmailAdministrator": {
    "type": "String",
    "metadata": {
     "variabila_de_mediu": true
    }
   }
  },
  "triggers": {
   "cand_se_modifica": {
    "type": "OpenApiConnectionWebhook",
    "inputs": {
     "host": {
      "connectionName": "shared_commondataserviceforapps",
      "operationId": "SubscribeWebhookTrigger"
     },
     "parameters": {
      "subscriptionRequest/message": 3,
      "subscriptionRequest/entityname": "rd_lotstabilizare",
      "subscriptionRequest/scope": 4
     }
    }
   }
  },
  "actions": {
   "Correlation_ID": {
    "type": "Compose",
    "runAfter": {},
    "inputs": "@{guid()}",
    "description": "Correlation ID pentru trasabilitate (22.6)"
   },
   "Try": {
    "type": "Scope",
    "runAfter": {
     "Correlation_ID": [
      "Succeeded"
     ]
    },
    "actions": {
     "Pas_01": {
      "type": "Compose",
      "runAfter": {},
      "inputs": "DE IMPLEMENTAT: Evalueaza conformitatea lotului conform 24.1.2",
      "description": "Evalueaza conformitatea lotului conform 24.1.2"
     },
     "Pas_02": {
      "type": "Compose",
      "runAfter": {
       "Pas_01": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Numara loturile conforme consecutive; reseteaza la primul neconform",
      "description": "Numara loturile conforme consecutive; reseteaza la primul neconform"
     },
     "Pas_03": {
      "type": "Compose",
      "runAfter": {
       "Pas_02": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Numara schimburile acoperite",
      "description": "Numara schimburile acoperite"
     },
     "Pas_04": {
      "type": "Compose",
      "runAfter": {
       "Pas_03": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: La al treilea lot conform: status Reusita, declanseaza gate-ul G7",
      "description": "La al treilea lot conform: status Reusita, declanseaza gate-ul G7"
     },
     "Pas_05": {
      "type": "Compose",
      "runAfter": {
       "Pas_04": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Lot neconform: creeaza automat o problema",
      "description": "Lot neconform: creeaza automat o problema"
     },
     "Pas_06": {
      "type": "Compose",
      "runAfter": {
       "Pas_05": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Diferenta de randament sub -3 pp: problema de categorie Financiar, severitate Majora",
      "description": "Diferenta de randament sub -3 pp: problema de categorie Financiar, severitate Majora"
     }
    },
    "runtimeConfiguration": {
     "retryPolicy": {
      "type": "exponential",
      "count": 4,
      "interval": "PT10S"
     }
    }
   },
   "Catch": {
    "type": "Scope",
    "runAfter": {
     "Try": [
      "Failed",
      "Skipped",
      "TimedOut"
     ]
    },
    "actions": {
     "Scrie_in_log": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "operationId": "CreateRecord"
       },
       "parameters": {
        "entityName": "rd_logeroares",
        "item/rd_flux": "FLX-31 Evaluarea loturilor de stabilizare",
        "item/rd_correlationid": "@{outputs('Correlation_ID')}",
        "item/rd_mesaj": "@{result('Try')}",
        "item/rd_statuslog": 100000000
       }
      },
      "description": "TBL-59, cerinta 12.1.3"
     },
     "Notifica_administratorul": {
      "type": "OpenApiConnection",
      "runAfter": {
       "Scrie_in_log": [
        "Succeeded",
        "Failed"
       ]
      },
      "inputs": {
       "host": {
        "connectionName": "shared_office365",
        "operationId": "SendEmailV2"
       },
       "parameters": {
        "emailMessage/To": "@parameters('rd_EmailAdministrator')",
        "emailMessage/Subject": "Esec FLX-31",
        "emailMessage/Body": "@{result('Try')}"
       }
      }
     }
    }
   }
  }
 }
}