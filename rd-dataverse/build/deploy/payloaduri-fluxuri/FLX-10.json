{
 "cod": "FLX-10",
 "nume": "FLX-10 Recalcularea scorului de prioritate",
 "val": 2,
 "conexiuni_necesare": [
  "shared_commondataserviceforapps",
  "shared_office365"
 ],
 "definitie": {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
   "$connections": {
    "defaultValue": {},
    "type": "Object"
   },
   "rd_EmailAdministrator": {
    "type": "String",
    "metadata": {
     "variabila_de_mediu": true
    }
   }
  },
  "triggers": {
   "Recurrence": {
    "type": "Recurrence",
    "recurrence": {
     "frequency": "Day",
     "interval": 1,
     "schedule": {
      "hours": [
       "7"
      ],
      "minutes": [
       0
      ]
     }
    },
    "metadata": {
     "frecventa_ceruta": "luni 06:00"
    }
   }
  },
  "actions": {
   "Correlation_ID": {
    "type": "Compose",
    "runAfter": {},
    "inputs": "@{guid()}",
    "description": "Correlation ID pentru trasabilitate (22.6)"
   },
   "Try": {
    "type": "Scope",
    "runAfter": {
     "Correlation_ID": [
      "Succeeded"
     ]
    },
    "actions": {
     "Pas_01": {
      "type": "Compose",
      "runAfter": {},
      "inputs": "DE IMPLEMENTAT: Calculeaza cele 6 componente din A1.1, cu ponderile din variabilele de mediu",
      "description": "Calculeaza cele 6 componente din A1.1, cu ponderile din variabilele de mediu"
     },
     "Pas_02": {
      "type": "Compose",
      "runAfter": {
       "Pas_01": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Adauga bonusul de imbatranire, plafonat la 20",
      "description": "Adauga bonusul de imbatranire, plafonat la 20"
     },
     "Pas_03": {
      "type": "Compose",
      "runAfter": {
       "Pas_02": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Verifica bugetul de urgenta pe KAM inainte de a promova in P1",
      "description": "Verifica bugetul de urgenta pe KAM inainte de a promova in P1"
     },
     "Pas_04": {
      "type": "Compose",
      "runAfter": {
       "Pas_03": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Scrie rd_scorprioritate si rd_banda; nu suprascrie proiectele cu scor suprascris",
      "description": "Scrie rd_scorprioritate si rd_banda; nu suprascrie proiectele cu scor suprascris"
     },
     "Pas_05": {
      "type": "Compose",
      "runAfter": {
       "Pas_04": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Expira suprascrierile mai vechi de 90 de zile",
      "description": "Expira suprascrierile mai vechi de 90 de zile"
     },
     "Pas_06": {
      "type": "Compose",
      "runAfter": {
       "Pas_05": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Trimite lista proiectelor care si-au schimbat banda",
      "description": "Trimite lista proiectelor care si-au schimbat banda"
     }
    },
    "runtimeConfiguration": {
     "retryPolicy": {
      "type": "exponential",
      "count": 4,
      "interval": "PT10S"
     }
    }
   },
   "Catch": {
    "type": "Scope",
    "runAfter": {
     "Try": [
      "Failed",
      "Skipped",
      "TimedOut"
     ]
    },
    "actions": {
     "Scrie_in_log": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "operationId": "CreateRecord"
       },
       "parameters": {
        "entityName": "rd_logeroares",
        "item/rd_flux": "FLX-10 Recalcularea scorului de prioritate",
        "item/rd_correlationid": "@{outputs('Correlation_ID')}",
        "item/rd_mesaj": "@{result('Try')}",
        "item/rd_statuslog": 100000000
       }
      },
      "description": "TBL-59, cerinta 12.1.3"
     },
     "Notifica_administratorul": {
      "type": "OpenApiConnection",
      "runAfter": {
       "Scrie_in_log": [
        "Succeeded",
        "Failed"
       ]
      },
      "inputs": {
       "host": {
        "connectionName": "shared_office365",
        "operationId": "SendEmailV2"
       },
       "parameters": {
        "emailMessage/To": "@parameters('rd_EmailAdministrator')",
        "emailMessage/Subject": "Esec FLX-10",
        "emailMessage/Body": "@{result('Try')}"
       }
      }
     }
    }
   }
  }
 }
}