     },
     "Pas_05": {
      "type": "Compose",
      "runAfter": {
       "Pas_04": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Adauga maximul adaosurilor pentru materii prime noi (A1.2.5)",
      "description": "Adauga maximul adaosurilor pentru materii prime noi (A1.2.5)"
     },
     "Pas_06": {
      "type": "Compose",
      "runAfter": {
       "Pas_05": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Scrie rd_termenpropus; precompleteaza rd_termennegociat daca e gol",
      "description": "Scrie rd_termenpropus; precompleteaza rd_termennegociat daca e gol"
     },
     "Pas_07": {
      "type": "Compose",
      "runAfter": {
       "Pas_06": [
        "Succeeded"
       ]
      },
      "inputs": "DE IMPLEMENTAT: Genereaza datele planificate pe etape",
      "description": "Genereaza datele planificate pe etape"
     }
    },
    "runtimeConfiguration": {
     "retryPolicy": {
      "type": "exponential",
      "count": 4,
      "interval": "PT10S"
     }
    }
   },
   "Catch": {
    "type": "Scope",
    "runAfter": {
     "Try": [
      "Failed",
      "Skipped",
      "TimedOut"
     ]
    },
    "actions": {
     "Scrie_in_log": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "operationId": "CreateRecord"
